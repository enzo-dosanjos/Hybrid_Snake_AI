@startuml MCD
title Hybrid Snake AI Architecture

package "Shared contracts" {
    enum Action {
        Left = 0
        Up = 1
        Right = 2
        Down = 3
    }

    class GameState <<value>> {
        + config : GameConfig
        + players : Players
        + currentPlayer : int
        + round : int
        + lastMoves : map<int, deque<Action>>
    }

    class EncodedState <<value>> {
        + board : BoardTensor
        + extraFeatures : vector<float>
        + legalActions : bitset<4>
    }

    class Transition <<value>> {
        + state : EncodedState
        + action : Action
        + reward : float
        + nextState : EncodedState
        + done : bool
    }

    note bottom of GameState
        Players maps stable IDs 1..N to PlayersData.
        PlayersData contains snake coordinates and alive status.
        GameState is a complete, independently copyable snapshot.
        currentPlayer and round identify the next scheduled turn.
        Histories are bounded and copied with the state.
    end note

    note bottom of EncodedState
        BoardTensor layout: [channel][y][x], 9 channels.
        0..2: own head/body/tail; 3..5: opponent head/body/tail;
        6: unoccupied cell; 7..8: normalized own head x/y.
        All coordinates and channels are rebuilt from GameState.
        One model supports a fixed N; W and H may vary.
        Extra features have a fixed, versioned order and length:
        opponents ordered by ID, retaining slots for dead players
        with an alive indicator and zeroed opponent metrics.
        Features include growth phase, scheduled player, and bounded
        action-history metrics used by rewards; perspective is explicit.
        Action values and masks use the Action enum order.
    end note
}

package "GameEnginePackage" {
    class GameEngine {
        - state : GameState
        - selector : PlayerSelector
        + GameEngine(config : GameConfig, origins : vector<Coord>)
        + GameEngine(snapshot : GameState)
        + getState() : const GameState&
        + getActionMask(player : int) : bitset<4>
        + updateStep(action : Action) : void
        + playerDied(player : int) : void
        + finishTurn() : void
        + isAlive(player : int) : bool
        + isTerminalState() : bool
        + isTerminalFor(player : int) : bool
        + successor(action : Action) : GameEngine
    }

    class PlayerSelector {
        + advance(state : GameState&) : void
    }

    note bottom of GameEngine
        Sole authority for movement, collision, growth and death.
        updateStep applies the current player's move, then finishes
        its turn; an illegal move eliminates that player.
        With no legal action, mark dead and finish the turn.
        playerDied is idempotent and does not advance time.
        finishTurn advances the scheduled slot, including dead slots;
        round increments when the schedule wraps from N to 1.
        Global terminal: at most one survivor.
        Terminal for p: global terminal or p has died.
        successor copies the entire engine and calls updateStep.
        Dead bodies follow the competition's occupancy rules.
    end note

    class Observation {
        + encode(state : GameState, perspective : int) : BoardTensor
    }

    class StateAnalyzer {
        + computeExtraFeatures(state : GameState, perspective : int) : vector<float>
        + computeSpatialMetrics(state : GameState, perspective : int) : vector<float>
        + computeGrowthSizeMetrics(state : GameState, perspective : int) : vector<float>
        + computeGameProgress(state : GameState) : float
        + computeGameplayMetrics(state : GameState, perspective : int) : vector<float>
        + computeActionEntropy(moves : deque<Action>) : float
        + computeKillZoneProximity(head : Coord, config : GameConfig) : float
    }

    class InputHandler {
        + readGameConfig() : GameConfig
        + readPlayersOrigins(numPlayers : int) : vector<Coord>
        + readEvent() : GameEvent
        + writeMove(move : Action) : void
    }

    note bottom of InputHandler
        GameEvent is a tagged Move(player, action), Death(player),
        End or InputError value; external IDs are normalized once.
        The game loop applies events using their supplied player ID
        and reconciles them with the engine's scheduled turn.
        Multiple notifications for a turn must not advance it twice.
    end note
}

package "DQNPackage" {
    abstract class NeuralNetwork {
        + {abstract} resetGradients() : void
        + {abstract} accumulateGradients() : void
        + {abstract} updateWeights(learningRate : float) : void
    }

    class CNN {
        - nn : vector<ConvolutionalLayer>
        + CNN(inputChannels : int, gen : mt19937)
        + addLayer(config : ConvLayerConfig) : void
        + copyWeights(src : CNN) : void
        + forwardPropagation(input : BoardTensor) : FeatureTensor
        + globalAvgPooling(input : FeatureTensor) : vector<float>
        + backPropagation(error : FeatureTensor) : void
    }

    class FCNN {
        - nn : vector<FullyConnectedLayer>
        + FCNN(inputSize : int, gen : mt19937)
        + addLayer(type : string, outputSize : int) : void
        + copyWeights(src : FCNN) : void
        + forwardPropagation(input : vector<float>) : vector<float>
        + backPropagation(error : vector<float>) : vector<float>
    }

    note bottom of CNN
        FeatureTensor also uses [channel][y][x].
        Global average pooling produces one value per output channel.
        FCNN input size = pooled channels + fixed extra-feature count.
        FCNN output size = 4, with a linear output layer.
        Forward passes cache activations for backward passes;
        FCNN backward returns the gradient with respect to its input.
        Concrete networks implement all abstract gradient operations.
    end note

    class DQN {
        - cnn : CNN
        - fcnn : FCNN
        - targetCNN : CNN
        - targetFCNN : FCNN
        - replayBuffer : ReplayBuffer
        - epsilon : float
        - gamma : float
        + DQN(config : ModelConfig, gen : mt19937)
        + selectAction(state : EncodedState, explore : bool) : optional<Action>
        + forwardPropagation(state : EncodedState) : array<float, 4>
        + remember(transition : Transition) : void
        + train(batchSize : int, learningRate : float) : void
        + updateTargetNetworks() : void
        - spreadError(pooledGradient : vector<float>, shape : TensorShape) : FeatureTensor
        - combineFeatures(pooled : vector<float>, extras : vector<float>) : vector<float>
        - decayEpsilon() : void
    }

    note bottom of DQN
        ModelConfig defines N, feature schema, layer shapes,
        replay capacity, gamma and exploration parameters.
        Target networks start as copies of the online networks.
        Targets use only legal next actions; no bootstrap when done.
        Gradient from the pooled part of the FCNN input is distributed
        through average pooling into CNN backpropagation.
        Raw Q-values remain unnormalized for Bellman learning.
    end note

    class ReplayBuffer {
        - buffer : deque<Transition>
        - capacity : int
        + ReplayBuffer(capacity : int, gen : mt19937)
        + push(transition : Transition) : void
        + createBatch(batchSize : int) : vector<Transition>
        + size() : int
    }

    class Reward {
        - rewards : NNRewards
        + computeReward(previous : GameState, next : GameState, player : int) : float
    }

    class ModelPersistence {
        + saveDQN(dqn : DQN, filename : string, trainingStep : int) : void
        + loadDQN(dqn : DQN&, filename : string) : int
    }

    note bottom of ModelPersistence
        Checkpoint includes model/feature schema, online and target
        weights, replay, exploration state and random-generator state.
        Load validates compatibility and restores trainingStep.
    end note

    class ResultValidation {
        + validate(agent : Agent&, validationSet : vector<GameConfig>) : ValidationResult
        + calculateScore(result : ValidationResult) : float
    }
}

package "AgentPackage" {
    interface Agent {
        + selectAction(engine : const GameEngine&) : optional<Action>
    }

    class DQNAgent {
        - dqn : DQN&
        - observation : Observation
        - analyzer : StateAnalyzer
        + DQNAgent(dqn : DQN&, explore : bool)
        + selectAction(engine : const GameEngine&) : optional<Action>
    }

    class MinimaxAgent {
        - minimax : Minimax
        + MinimaxAgent(params : MinimaxParams)
        + selectAction(engine : const GameEngine&) : optional<Action>
    }

    class HybridAgent {
        - dqn : DQN&
        - minimax : Minimax
        - observation : Observation
        - analyzer : StateAnalyzer
        - lambda : float
        + HybridAgent(dqn : DQN&, params : MinimaxParams, lambda : float, explore : bool)
        + selectAction(engine : const GameEngine&) : optional<Action>
    }

    note bottom of Agent
        Called for the engine's current living player.
        Perspective = currentPlayer at the decision root.
        Returns only legal actions; none if terminal or no legal move.
        Selection does not mutate the supplied game state.
        Validation disables exploration for neural agents.
    end note

    note bottom of HybridAgent
        0 <= lambda <= 1; larger scores are better.
        Normalize each score vector over legal actions to [0,1]
        (equal scores map to 0), then maximize:
        (1-lambda) * minimaxScore + lambda * qValue.
        Training exploration may instead choose a random legal action.
        This weighting is a decision rule, not a survival guarantee.
        DQNAgent/HybridAgent borrow a DQN that outlives them.
    end note
}

package "MinimaxPackage" {
    class Minimax {
        - params : MinimaxParams
        - analyzer : SpaceRiskAnalyzer
        + calculateMoveScores(engine : const GameEngine&) : map<Action, float>
        - evaluateState(state : GameState, rootPlayer : int) : float
        - minimax(engine : GameEngine, depth : int, alpha : float, beta : float, rootPlayer : int) : float
    }

    note bottom of Minimax
        Root player maximizes; all opponents minimize the root value.
        All leaf and terminal scores are finite and use the root perspective.
        Terminal win/loss scores take precedence over heuristic values.
        Search copies complete states and uses engine transitions.
        Dead slots and no-legal-action deaths follow engine rules.
        Score every legal root action with a fresh full search window
        so hybrid combination receives values, not pruning bounds.
    end note

    class SpaceRiskAnalyzer {
        - maxLookAhead : int
        - decayFactor : float
        + analyzeState(state : GameState, player : int) : SpaceRiskResult
        + computeReachTiming(state : GameState) : ReachTiming
        + calculateAreas(state : GameState) : AreaResult
        + calculateRiskHeatmap(timing : ReachTiming, player : int) : Matrix<float>
        + calculateDirectionalRisk(heatmap : Matrix<float>, head : Coord) : float
    }

    note bottom of SpaceRiskAnalyzer
        Matrices use [y][x]. Reach timing is tracked per player/cell.
        Static occupancy analysis is a heuristic, not proof of safety.
        Any cache key includes all state/configuration used by analysis.
    end note
}

package "Application" {
    class GameLoop <<control>> {
        + run(agent : Agent&, io : InputHandler&) : void
    }

    class TrainingLoop <<control>> {
        + train(behavior : Agent&, learner : DQN&, config : TrainingConfig) : void
    }

    note bottom of TrainingLoop
        Control roles may be implemented as functions.
        Runs episodes and opponent turns through GameEngine.
        Builds transitions from one learner decision to its next,
        or to its death/game end; stores the action actually executed.
        Reward covers that complete interval; gamma is per decision.
        History and turn context are encoded by the shared encoders.
        done also covers an empty next legal-action mask.
        Owns the DQN borrowed by the behavior agent, schedules replay
        training/target synchronization and invokes persistence/validation.
    end note
}

class Utils <<utility>> {
    + isInbound(coord : Coord, config : GameConfig) : bool
    + computeOppositeDir(move : Action) : Action
    + computeNewCoord(head : Coord, move : Action) : Coord
}

Agent <|.. DQNAgent
Agent <|.. MinimaxAgent
Agent <|.. HybridAgent
NeuralNetwork <|-- CNN
NeuralNetwork <|-- FCNN
GameEngine *-- GameState
GameEngine *-- PlayerSelector
GameEngine ..> Utils
Observation ..> GameState
StateAnalyzer ..> GameState
DQN *-- "2" CNN : online / target
DQN *-- "2" FCNN : online / target
DQN *-- ReplayBuffer
ReplayBuffer *-- "0..*" Transition
Transition *-- "2" EncodedState
DQNAgent --> DQN : borrows
HybridAgent --> DQN : borrows
DQNAgent ..> Observation
DQNAgent ..> StateAnalyzer
HybridAgent ..> Observation
HybridAgent ..> StateAnalyzer
MinimaxAgent *-- Minimax
HybridAgent *-- Minimax
Minimax *-- SpaceRiskAnalyzer
Minimax ..> GameEngine : simulates copies
GameLoop ..> GameEngine
GameLoop ..> Agent
GameLoop ..> InputHandler
TrainingLoop ..> GameEngine
TrainingLoop ..> Agent
TrainingLoop ..> DQN
TrainingLoop ..> Observation
TrainingLoop ..> StateAnalyzer
TrainingLoop ..> Reward
TrainingLoop ..> ModelPersistence
TrainingLoop ..> ResultValidation
ModelPersistence ..> DQN
ResultValidation ..> Agent
ResultValidation ..> GameEngine

@enduml
