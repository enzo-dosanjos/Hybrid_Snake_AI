@startuml MCD
title Hybrid Snake AI Architecture

package "Shared contracts" {
    enum Action {
        Left = 0
        Up = 1
        Right = 2
        Down = 3
    }

    class GameConfig <<value>> {
        + W : int
        + H : int
        + M : int
        + N : int
        + P : int
    }

    class PlayersData <<value>> {
        + snake : deque<Coord>
        + playerInfo : PlayersInfo
    }

    class PlayersInfo <<value>> {
        + origin : Coord
        + alive : bool
        + actionMask : ActionMask
    }

    class GameState <<value>> {
        + config : GameConfig
        + players : Players
        + currentPlayer : int
        + round : int
        + lastMoves : map<int, deque<Action>>
    }

    class EncodedState <<value>> {
        + board : BoardTensor
        + extraFeatures : vector<float>
        + legalActions : ActionMask
    }

    class Transition <<value>> {
        + state : EncodedState
        + action : Action
        + reward : float
        + nextState : EncodedState
        + done : bool
    }

    note bottom of GameState
        Players maps stable IDs 1..N to PlayersData.
        GameConfig stores width, height, growth period, player count and controlled seat.
        PlayersData stores head-to-tail coordinates and player metadata.
        GameState is a complete, independently copyable snapshot.
        currentPlayer and round identify the next scheduled turn.
        Histories are bounded and copied with the state.
    end note

    note bottom of EncodedState
        BoardTensor layout: [channel][y][x], 4*N+1 channels (schema 2).
        Each player has head/body/tail/segment-order channels;
        segment order = (index from head + 1)/(W*H); final channel is free cells.
        Slots: perspective player first, then ascending opponent IDs.
        Dead bodies retain their geometry. One model supports a fixed N.
        Required extra context: W,H,M,round%M,round,currentPlayer,perspective,
        then player ID and alive flag for every board slot.
        FeatureSelection enables derived distance, size, progress, mobility
        and wall-proximity groups. Histories are diagnostic, not model inputs.
        Both schemas and feature selection must be checked when loading weights.
        ActionMask is a bitset of four directions in Action enum order.
    end note
}

package "GameEnginePackage" {
    class GameEngine {
        - state : GameState
        - selector : PlayerSelector
        + GameEngine(config : GameConfig, origins : vector<Coord>)
        + GameEngine(snapshot : GameState)
        + getState() : const GameState&
        + getActionMask(player : int) : ActionMask
        + updateStep(action : Action) : void
        + playerDied(player : int) : void
        + finishTurn() : void
        + isAlive(player : int) : bool
        + willDieNextTurn(player : int) : bool
        + isTerminalState() : bool
        + isTerminalFor(player : int) : bool
        + successor(action : Action) : GameEngine
    }

    class PlayerSelector {
        + advance(state : GameState&) : void
    }

    note bottom of GameEngine
        Sole authority for movement, collision, growth and death.
        updateStep applies the current living player's action and advances
        the schedule. A direction blocked by a collision eliminates the player.
        An invalid Action value or a move in a terminal game is rejected.
        With no legal action, callers can mark dead and finish the turn.
        playerDied is idempotent and leaves the schedule unchanged.
        finishTurn advances the scheduled slot, including dead slots;
        round increments when the schedule wraps from N to 1.
        Global terminal: at most one survivor.
        Terminal for p: global terminal or p has died.
        successor copies the entire engine and calls updateStep.
        On growth rounds (including round zero), the tail stays in place.
        Retained dead bodies continue to occupy their cells.
    end note

    class Observation {
        + encode(state : GameState, perspective : int) : BoardTensor
    }

    class StateAnalyzer {
        + computeExtraFeatures(state : GameState, perspective : int, selection : FeatureSelection) : vector<float>
        + {static} getFeatureCount(numPlayers : int, selection : FeatureSelection) : int
        + computeSpatialMetrics(state : GameState, perspective : int) : vector<float>
        + computeGrowthSizeMetrics(state : GameState, perspective : int) : vector<float>
        + computeGameProgress(state : GameState) : float
        + computeGameplayMetrics(state : GameState, perspective : int) : vector<float>
    }

    class DecisionEncoding <<module>> {
        + encodeDecision(engine : const GameEngine&, player : int, features : const FeatureSelection&) : EncodedState
    }

    class InputHandler {
        + {static} readGameConfig(input : istream&) : GameConfig
        + {static} readPlayersOrigins(numPlayers : int, input : istream&) : vector<Coord>
        + {static} readEvent(numPlayers : int, input : istream&) : GameEvent
        + {static} writeMove(move : Action, output : ostream&) : void
    }

    note bottom of InputHandler
        GameEvent carries a type, normalized player ID, optional action and error text.
        The controlled seat in setup is already one-based.
        The reader converts zero-based event player IDs to one-based IDs.
        The game loop applies events using their supplied player ID
        and reconciles them with the engine's scheduled turn.
        A paired death and move notification advances the schedule once.
    end note
}

package "DQNPackage" {
    abstract class NeuralNetwork {
        + {abstract} resetGradients() : void
        + {abstract} accumulateGradients() : void
        + {abstract} updateWeights(learningRate : float) : void
    }

    class CNN {
        - nn : vector<ConvolutionalLayer>
        + CNN(inputChannels : int, gen : mt19937)
        + addLayer(config : ConvLayerConfig) : void
        + copyWeights(src : CNN) : void
        + forwardPropagation(input : BoardTensor) : FeatureTensor
        + {static} globalAvgPooling(input : FeatureTensor) : vector<float>
        + {static} globalAvgPoolingBackward(pooledGradient : vector<float>, input : FeatureTensor) : FeatureTensor
        + backPropagation(error : FeatureTensor) : void
    }

    class FCNN {
        - nn : vector<FullyConnectedLayer>
        + FCNN(inputSize : int, gen : mt19937)
        + addLayer(type : string, outputSize : int) : void
        + copyWeights(src : FCNN) : void
        + forwardPropagation(input : vector<float>) : vector<float>
        + backPropagation(error : vector<float>) : vector<float>
    }

    note bottom of CNN
        FeatureTensor also uses [channel][y][x].
        Global average pooling produces one value per output channel.
        FCNN input size = pooled channels + fixed extra-feature count.
        FCNN output size = 4, with a linear output layer.
        Forward passes cache activations for backward passes;
        FCNN backward returns the gradient with respect to its input.
        Concrete networks implement all abstract gradient operations.
    end note

    class DQN {
        - cnn : CNN
        - fcnn : FCNN
        - targetCNN : CNN
        - targetFCNN : FCNN
        - replayBuffer : ReplayBuffer
        - config : ModelConfig
        - epsilon : float
        - gen : mt19937
        + DQN(config : ModelConfig, gen : mt19937)
        + selectAction(state : EncodedState, explore : bool) : optional<Action>
        + sampleExplorationAction(legalActions : ActionMask) : optional<Action>
        + forwardPropagation(state : EncodedState) : array<float, 4>
        + remember(transition : Transition) : void
        + train(batchSize : int, learningRate : float) : void
        + updateTargetNetworks() : void
        + getFeatureSelection() : const FeatureSelection&
        - bellmanTarget(transition : Transition) : float
        - decayEpsilon() : void
    }

    note bottom of DQN
        ModelConfig defines N, feature schema, layer shapes,
        replay capacity, gamma and exploration parameters.
        Target networks start as copies of the online networks.
        Targets bootstrap over legal next actions when the transition
        continues and the next mask has at least one legal action.
        Gradient from the pooled part of the FCNN input is distributed
        through average pooling into CNN backpropagation.
        Raw Q-values remain unnormalized for Bellman learning.
    end note

    class ReplayBuffer {
        - buffer : deque<Transition>
        - capacity : int
        + ReplayBuffer(capacity : int, gen : mt19937)
        + push(transition : Transition) : void
        + createBatch(batchSize : int) : vector<Transition>
        + size() : int
    }

    note bottom of ReplayBuffer
        At capacity, evict the oldest transition (FIFO).
        Sample uniformly without replacement using the seeded generator,
        up to the smaller of batch size and stored transition count.
    end note

    class Reward {
        - config : GameConfig
        - rewards : NNRewards
        + Reward(config : GameConfig)
        + computeReward(previous : GameState, next : GameState, player : int) : float
    }

    note bottom of Reward
        Award the setup bonus when a surviving opponent goes from
        more than two legal moves to two or fewer across the interval.
        Credit observed alive-to-dead transitions once.
        A sole-survivor win includes the final elimination payoff.
        Death or an empty learner mask with surviving opponents yields a loss.
    end note

    class ModelPersistence {
        + saveDQN(dqn : const DQN&, filename : string, trainingStep : int) : void
        + loadDQN(dqn : DQN&, filename : string) : int
    }

    note bottom of ModelPersistence
        Checkpoint includes model/feature schema, online and target
        weights, replay, exploration state and random-generator state.
        Load validates compatibility and restores trainingStep.
    end note

    class ValidationMatch <<value>> {
        + config : GameConfig
        + origins : vector<Coord>
        + opponents : vector<reference_wrapper<Agent>>
    }

    class ValidationResult <<value>> {
        + matches : size_t
        + wins : size_t
        + meanSurvivalTurns : double
    }

    class ResultValidation {
        + validate(agent : Agent&, validationSet : vector<ValidationMatch>) : ValidationResult
        + calculateScore(result : ValidationResult) : float
    }

    note bottom of ResultValidation
        Callers supply the board, origins, evaluated seat and opponents.
        Callers supply agents with exploration disabled.
        Opponents are in ascending seat order, omitting the evaluated seat.
        Score is the fraction of matches won.
        Mean survival counts living players' turns through the evaluated
        player's death or the end of the game.
    end note
}

package "AgentPackage" {
    interface Agent {
        + selectAction(engine : const GameEngine&) : optional<Action>
    }

    class DQNAgent {
        - dqn : DQN&
        - explore : bool
        + DQNAgent(dqn : DQN&, explore : bool)
        + selectAction(engine : const GameEngine&) : optional<Action>
    }

    class MinimaxAgent {
        - minimax : Minimax
        + MinimaxAgent(params : MinimaxParams)
        + selectAction(engine : const GameEngine&) : optional<Action>
    }

    class HybridAgent {
        - dqn : DQN&
        - minimax : Minimax
        - explore : bool
        - lambda : float
        + HybridAgent(dqn : DQN&, params : MinimaxParams, lambda : float, explore : bool)
        + selectAction(engine : const GameEngine&) : optional<Action>
    }

    note bottom of Agent
        Called for the engine's current living player.
        Perspective = currentPlayer at the decision root.
        Returns only legal actions; none if terminal or no legal move.
        Selection does not mutate the supplied game state.
        Validation disables exploration for neural agents.
    end note

    note bottom of HybridAgent
        0 <= lambda <= 1; larger scores are better.
        Normalize each score vector over legal actions to [0,1]
        (equal scores map to 0), then maximize:
        (1-lambda) * minimaxScore + lambda * qValue.
        Training exploration may instead choose a random legal action.
        Ties follow Action enum order.
        DQNAgent and HybridAgent borrow a DQN that outlives them.
    end note
}

package "MinimaxPackage" {
    class Minimax {
        - params : MinimaxParams
        - analyzer : SpaceRiskAnalyzer
        + calculateMoveScores(engine : const GameEngine&) : map<Action, float>
        - evaluateState(state : GameState, rootPlayer : int) : float
        - minimax(engine : const GameEngine&, depth : int, alpha : float, beta : float, rootPlayer : int) : float
    }

    note bottom of Minimax
        Root player maximizes; all opponents minimize the root value.
        All leaf and terminal scores are finite and use the root perspective.
        Terminal win/loss scores take precedence over heuristic values.
        Search copies complete states and uses engine transitions.
        Dead slots and no-legal-action deaths follow engine rules.
        Score every legal root action with a fresh full search window
        so hybrid combination receives each action's search value.
    end note

    class SpaceRiskAnalyzer {
        - maxLookahead : int
        - decayFactor : float
        - decayTable : vector<float>
        + SpaceRiskAnalyzer(lookahead : int, decay : float)
        + analyzeState(state : GameState, player : int) : SpaceRiskResult
        + computeReachTiming(state : GameState) : ReachTiming
        + calculateAreas(state : GameState) : AreaResult
        + calculateRiskHeatmap(timing : ReachTiming, player : int) : Matrix<float>
        + calculateDirectionalRisk(heatmap : Matrix<float>, head : Coord) : float
    }

    note bottom of SpaceRiskAnalyzer
        Matrices use [y][x]. Reach timing is tracked per player/cell.
        Each analysis recomputes reach and territory from the snapshot.
        Snake bodies are held fixed, including tails and dead bodies.
        Risk uses scheduled arrivals and a precomputed decay table.
    end note
}

package "Application" {
    class "AI" as Play <<executable>> {
        - playGame(engine : GameEngine&, agent : Agent&) : void
    }

    class "train" as Train <<executable>> {
        - runTraining(config : const TrainingConfig&) : void
    }

    note bottom of Train
        train.cpp owns the learner and constructs behavior and evaluation agents.
        Schedules replay updates, target synchronization, saves and evaluation.
    end note

    class TrainingLoop <<module>> {
        + playLearnerDecision(engine : GameEngine&, behavior : Agent&, opponents : vector<reference_wrapper<Agent>>, reward : Reward, features : FeatureSelection) : optional<Transition>
    }

    note bottom of TrainingLoop
        Returns a transition spanning one executed learner action and
        intervening opponent turns through the next decision or termination.
        Reward covers the interval and gamma is per learner decision.
        done also covers an empty next legal-action mask.
        If the learner cannot execute an action, returns no transition.
    end note

    class "optimise" as Optimise <<executable>> {
        - optimise(config : OptimiseConfig, validationSet : vector<ValidationMatch>) : Individual
    }

    note bottom of Optimise
        Evaluate every candidate against fixed opponents on the supplied setups.
        Rank by win rate and report mean survival turns separately.
        Save the winning weights and depth.
    end note

    class MinimaxParamsFile <<module>> {
        + loadMinimaxParams(filename : string) : MinimaxParams
        + saveMinimaxParams(params : MinimaxParams, filename : string) : void
    }

    note bottom of MinimaxParamsFile
        Play and training load parameters once at startup when requested.
    end note
}

class Utils <<utility>> {
    + validateGameConfig(config : GameConfig) : void
    + isInbound(coord : Coord, config : GameConfig) : bool
    + computeKillZoneProximity(head : Coord, config : GameConfig) : float
    + computeOppositeDir(move : Action) : Action
    + computeNewCoord(head : Coord, move : Action) : Coord
}

Agent <|.. DQNAgent
Agent <|.. MinimaxAgent
Agent <|.. HybridAgent
NeuralNetwork <|-- CNN
NeuralNetwork <|-- FCNN
GameEngine *-- GameState
GameEngine *-- PlayerSelector
GameState *-- GameConfig
GameState *-- "1..*" PlayersData
PlayersData *-- PlayersInfo
GameEngine ..> Utils
Observation ..> GameState
StateAnalyzer ..> GameState
DQN *-- "2" CNN : online / target
DQN *-- "2" FCNN : online / target
DQN *-- ReplayBuffer
ReplayBuffer *-- "0..*" Transition
Transition *-- "2" EncodedState
DQNAgent --> DQN : borrows
HybridAgent --> DQN : borrows
DQNAgent ..> DecisionEncoding
HybridAgent ..> DecisionEncoding
DecisionEncoding ..> GameEngine
DecisionEncoding ..> Observation
DecisionEncoding ..> StateAnalyzer
MinimaxAgent *-- Minimax
HybridAgent *-- Minimax
Minimax *-- SpaceRiskAnalyzer
Minimax ..> GameEngine : simulates copies
Play ..> GameEngine
Play ..> Agent
Play ..> InputHandler
Play ..> ModelPersistence : loads checkpoint
Play ..> MinimaxParamsFile : loads parameters
Train ..> InputHandler
Train ..> GameEngine
Train ..> Agent
Train *-- DQN : owns learner
Train ..> TrainingLoop
Train ..> ModelPersistence
Train ..> ResultValidation
Train ..> MinimaxParamsFile : loads parameters
TrainingLoop ..> GameEngine
TrainingLoop ..> Agent
TrainingLoop ..> DecisionEncoding
TrainingLoop ..> Reward
ModelPersistence ..> DQN
ResultValidation ..> ValidationMatch
ResultValidation ..> ValidationResult
ResultValidation ..> Agent
ResultValidation ..> GameEngine
Optimise ..> InputHandler
Optimise ..> ResultValidation
Optimise ..> MinimaxAgent
Optimise ..> MinimaxParamsFile : saves winner

@enduml
